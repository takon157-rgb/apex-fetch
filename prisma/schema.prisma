generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  New
  Contacted
  Interested
  Closed
}

model User {
  id                String       @id @default(uuid())
  clerkId           String       @unique
  email             String?
  name              String?
  discordWebhookUrl String?      @db.Text
  isSubscribed      Boolean      @default(false)
  creditsRemaining  Int          @default(10)
  paystackCustomerCode String?
  referralCode      String?      @unique @default(uuid())
  referredBy        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  leads             Lead[]
  localLeads        LocalLead[]
  businessLeads     LocalBusinessLead[]
  preferences       UserPreference?
  careerProfile     CareerProfile?
  reviewedJobs      ReviewedJob[]
  scrapeSessions    ScrapeSession[]
  blacklistedKeywords BlacklistedKeyword[]
  sourceHealth      SourceHealth[]
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  targetRoles         String[]
  coreSkills          String[]
  parsedResumeSummary String?  @db.Text
  setupComplete       Boolean  @default(false)
  /// Career pages and job boards this account wants scraped directly.
  targetUrls          String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String   @id @default(uuid())
  userId        String
  title         String
  company       String?
  description   String   @db.Text
  budget        String   @default("")
  salaryMin     Float?
  salaryMax     Float?
  salaryCurrency String? @default("USD")
  location      String?
  jobType       String?
  remote        Boolean? @default(true)
  timezone      String?
  postedAt      DateTime?
  tags          String[] @default([])
  source        String
  url           String
  aiScore       Int      @default(0)
  matchReason   String?  @db.Text
  proposalDraft String?  @db.Text
  status        String   @default("active")
  applied       Boolean  @default(false)
  appliedAt     DateTime?
  tracked       Boolean  @default(false)
  deleted       Boolean  @default(false)
  createdAt     DateTime @default(now())

  // --- ApexFetch application lifecycle ---
  fitScore         Int?
  fitMatched       String[] @default([])
  fitMissing       String[] @default([])
  fitReason        String?  @db.Text
  tailoredResume   String?  @db.Text
  coverEmail       String?  @db.Text
  applicationEmail String?
  applicationStatus String  @default("found")
  approvedAt       DateTime?
  sentAt           DateTime?
  resumePdfPath    String?

  updatedAt        DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, postedAt])
  @@index([url])
  @@index([userId, applicationStatus])
}

model ReviewedJob {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String   @db.Text
  tailoredResume String?  @db.Text
  coverLetter    String?  @db.Text
  reviewedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  name           String
  email          String
  resumeFileName String
  resumeBase64   String   @db.Text
  resumeText     String   @db.Text
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocalBusinessLead {
  id               String     @id @default(cuid())
  userId           String
  businessName     String
  niche            String?
  city             String?
  address          String?
  phoneNumber      String?
  rating           Float?
  reviewCount      Int?
  googleMapsUrl    String?
  opportunityScore Int
  aiAnalysis       String?
  coldCallScript   String?
  emailPitch       String?
  status           LeadStatus @default(New)
  createdAt        DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])
}

model LocalLead {
  id               String   @id @default(uuid())
  userId           String
  businessName     String
  niche            String
  city             String
  phoneNumber      String?
  rating           Float?
  reviewCount      Int?
  googleMapsUrl    String?
  opportunityScore Int
  aiAnalysis       String?  @db.Text
  coldCallScript   String?  @db.Text
  emailPitch       String?  @db.Text
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ScrapeSession {
  id              String   @id @default(uuid())
  userId          String
  status          String   @default("running")
  totalSources    Int      @default(0)
  completedSources Int     @default(0)
  currentSource   String   @default("")
  leadsFound      Int      @default(0)
  leadsPruned     Int      @default(0)
  error           String?  @db.Text
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlacklistedKeyword {
  id        String   @id @default(uuid())
  userId    String
  keyword   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
}

model SourceHealth {
  id        String   @id @default(uuid())
  userId    String
  source    String
  success   Boolean
  leadsCount Int     @default(0)
  errorMsg  String?  @db.Text
  checkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
